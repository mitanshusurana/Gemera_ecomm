# ==========================================
# STOREFRONT VM (docker-compose.frontend.yml). Copy to .env.frontend.
# Values are injected into the built bundles by env-subst.sh when the container starts.
# ==========================================

# Public API URL used by the browser.
API_URL=https://api.caratloop.com/api/v1
# API URL used by the SSR server itself (same value unless the API is reachable on a private network).
SSR_API_URL=https://api.caratloop.com/api/v1

# Razorpay publishable key (key_id). Must match RAZORPAY_KEY_ID on the API.
RAZORPAY_KEY=rzp_live_your_key_id

# Company details shown in the footer and contact page when the API is unreachable.
WHATSAPP_NUMBER=917976091951
COMPANY_ADDRESS=S149 Mahaveer Nagar, Jaipur
COMPANY_PHONE=+91 7976091951
COMPANY_EMAIL=support@caratloop.com
COMPANY_INSTAGRAM=https://instagram.com/caratloopjewels
COMPANY_FACEBOOK=https://facebook.com/caratloop

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Optional image override
# FRONTEND_IMAGE=ghcr.io/mitanshusurana/gemera_ecomm-frontend:latest

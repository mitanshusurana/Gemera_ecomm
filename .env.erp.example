# docker-compose.erp.yml reads this file. Copy to .env.erp and fill in.
POSTGRES_PASSWORD=
# The same password, URL-encoded (e.g. @ -> %40), for the connection strings.
POSTGRES_PASSWORD_URLENC=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
GSTIN_API_KEY=
SUREPASS_TOKEN=
# Storefront bridge: a long random secret, identical to ERP_API_KEY in .env.backend.
ECOMMERCE_API_KEY=
# Ledger account credited with Razorpay settlements and debited for refunds.
ECOMMERCE_SETTLEMENT_ACCOUNT_CODE=BNK-001
# Needed only when more than one company exists in the ERP.
ECOMMERCE_COMPANY_ID=
# Item-master codes for old metal bought through the storefront exchange programme.
ECOMMERCE_OLD_GOLD_MATERIAL_CODE=OLD-GOLD
ECOMMERCE_OLD_SILVER_MATERIAL_CODE=OLD-SILVER
COMPANY_STATE_CODE=08
COMPANY_STATE_NAME=Rajasthan
ENVIRONMENT=production
# Only when the UI and API are on different origins; same-origin via the UI proxy needs none.
CORS_ORIGINS=["http://localhost:3001"]
# Host port the ERP UI is published on (loopback); the host reverse proxy routes the ERP host name here.
ERP_UI_PORT=3001

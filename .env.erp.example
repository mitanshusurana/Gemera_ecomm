# docker-compose.erp.yml reads this file. Copy to .env.erp and fill in.
POSTGRES_PASSWORD=
# The same password, URL-encoded (e.g. @ -> %40), for the connection strings.
POSTGRES_PASSWORD_URLENC=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
GSTIN_API_KEY=
SUREPASS_TOKEN=
COMPANY_STATE_CODE=08
COMPANY_STATE_NAME=Rajasthan
ENVIRONMENT=production
CORS_ORIGINS=["https://erp.example.com"]

# ==========================================
# BACKEND CONFIGURATION (Original VM)
# ==========================================

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
POSTGRES_DB=jewelry_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_secure_password

# ------------------------------------------
# BACKEND APP CONFIGURATION
# ------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/jewelry_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme_secure_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

ADMIN_EMAIL=admin@gemara.com
ADMIN_PASSWORD=change_me_strong_password
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE
# ------------------------------------------
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=jewelry-assets
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# ------------------------------------------
# ADMIN APP URL
# ------------------------------------------
# IMPORTANT: Since Admin runs in the user's browser,
# this URL must point to the PUBLIC IP or DOMAIN of this VM.
# Replace '<ORIGINAL_VM_PUBLIC_IP>' with the actual IP address or domain.
ADMIN_API_URL=http://<ORIGINAL_VM_PUBLIC_IP>:8080/api/v1
API_URL=http://<ORIGINAL_VM_PUBLIC_IP>:8080/api/v1


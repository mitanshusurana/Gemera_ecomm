# ==========================================
# CORE VM: database, API and admin (docker-compose.backend.yml)
# Copy to .env.backend. Every variable without a default is required: the API refuses to start otherwise.
# ==========================================

# --- PostgreSQL (container) ---
POSTGRES_DB=jewelry_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- API: database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/jewelry_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_db_password
# Schema is managed by Hibernate (no migration tool). Keep "update"; "validate" only works on an already-created schema.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- API: security ---
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_EMAIL=admin@caratloop.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
# Browser origins allowed to call the API: storefront and admin, comma separated, scheme included.
CORS_ALLOWED_ORIGINS=https://www.caratloop.com,https://admin.caratloop.com
# Storefront origin used in password-reset emails.
FRONTEND_URL=https://www.caratloop.com

# --- API: email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your-email@gmail.com

# --- API: payments (Razorpay). Leave empty to disable online payment; gift cards and card checkout then return 503. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- API: metal prices ---
GOLDAPI_KEY=your_goldapi_key

# --- API: Cloudflare R2 object storage (product and hero images) ---
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=jewelry-assets
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# --- Admin SPA (runs in the browser, so these must be PUBLIC URLs) ---
API_URL=https://api.caratloop.com/api/v1
STOREFRONT_URL=https://www.caratloop.com

# --- Image overrides (optional) ---
# BACKEND_IMAGE=ghcr.io/mitanshusurana/gemera_ecomm-backend:latest
# ADMIN_IMAGE=ghcr.io/mitanshusurana/gemera_ecomm-admin:latest

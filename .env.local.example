# ==========================================
# LOCAL: all services from source (docker-compose.local.yml). Copy to .env.local.
# ==========================================

# --- PostgreSQL ---
POSTGRES_DB=jewelry_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdevpassword

# --- API ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/jewelry_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=localdevpassword
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Must decode as Base64 (hex is fine): JwtUtils rejects "_" or "-". Generate with: openssl rand -hex 32
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_EMAIL=admin@caratloop.com
ADMIN_PASSWORD=Admin12345!
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
FRONTEND_URL=http://localhost:4200

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your-email@gmail.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOLDAPI_KEY=your_goldapi_key

# --- ERP bridge (optional). ERP_API_KEY must equal ECOMMERCE_API_KEY in .env.erp.
# With docker-compose.erp.yml on the same laptop the ERP API is published on
# 127.0.0.1:8010; the API container reaches it through host.docker.internal
# (docker-compose.local.yml maps it to the host gateway). Leave both empty to
# queue invoices in erp_sync_events without sending them.
ERP_BASE_URL=http://host.docker.internal:8010
ERP_API_KEY=change_me_same_as_ECOMMERCE_API_KEY_in_env_erp

R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# --- Storefront (browser) and SSR server ---
# Host ports published by docker-compose.local.yml. Change API_PORT (and API_URL
# below to match) when something else on the laptop already listens on 8080.
API_PORT=8080
STOREFRONT_PORT=4200
ADMIN_PORT=4300
API_URL=http://localhost:8080/api/v1
SSR_API_URL=http://backend:8080/api/v1
# Host names the SSR server accepts in the Host header (Angular SSR 20.3+ rejects every other
# request with "Header host ... is not allowed" and falls back to client-side rendering).
# Comma separated, no scheme or port; "*.example.com" wildcards are allowed.
NG_ALLOWED_HOSTS=localhost,127.0.0.1
RAZORPAY_KEY=rzp_test_your_key_id
WHATSAPP_NUMBER=917976091951
COMPANY_ADDRESS=S149 Mahaveer Nagar, Jaipur
COMPANY_PHONE=+91 7976091951
COMPANY_EMAIL=support@caratloop.com
COMPANY_INSTAGRAM=https://instagram.com/caratloopjewels
COMPANY_FACEBOOK=https://facebook.com/caratloop
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# --- Admin SPA ---
STOREFRONT_URL=http://localhost:4200

# ==========================================
# LOCAL DEVELOPMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
POSTGRES_DB=jewelry_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_db_password

# ------------------------------------------
# BACKEND APP CONFIGURATION
# ------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/jewelry_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_db_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

ADMIN_EMAIL=admin@caratloop.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ------------------------------------------
# MAIL CONFIGURATION
# ------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your-email@gmail.com

# ------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE
# ------------------------------------------
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# ------------------------------------------
# GOLD API
# ------------------------------------------
GOLDAPI_KEY=your_goldapi_key

# ------------------------------------------
# FRONTEND & ADMIN URLs
# ------------------------------------------
# Pointing to the local backend container (through localhost mapping or docker network)
API_URL=http://localhost:8080/api/v1
SSR_API_URL=http://backend:8080/api/v1

RAZORPAY_KEY=rzp_test_your_key_here
WHATSAPP_NUMBER=917976091951

NG_ALLOWED_HOSTS=localhost,127.0.0.1
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

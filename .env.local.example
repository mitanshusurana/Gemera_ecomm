# ==========================================
# LOCAL: all services from source (docker-compose.local.yml). Copy to .env.local.
# ==========================================

# --- PostgreSQL ---
POSTGRES_DB=jewelry_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdevpassword

# --- API ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/jewelry_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=localdevpassword
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JWT_SECRET=local_dev_secret_change_me_0123456789abcdef
ADMIN_EMAIL=admin@caratloop.com
ADMIN_PASSWORD=Admin12345!
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
FRONTEND_URL=http://localhost:4200

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your-email@gmail.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOLDAPI_KEY=your_goldapi_key

R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# --- Storefront (browser) and SSR server ---
API_URL=http://localhost:8080/api/v1
SSR_API_URL=http://backend:8080/api/v1
RAZORPAY_KEY=rzp_test_your_key_id
WHATSAPP_NUMBER=917976091951
COMPANY_ADDRESS=S149 Mahaveer Nagar, Jaipur
COMPANY_PHONE=+91 7976091951
COMPANY_EMAIL=support@caratloop.com
COMPANY_INSTAGRAM=https://instagram.com/caratloopjewels
COMPANY_FACEBOOK=https://facebook.com/caratloop
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# --- Admin SPA ---
STOREFRONT_URL=http://localhost:4200

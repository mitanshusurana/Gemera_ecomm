# Secrets must never enter the build context (they land in builder layers and
# in any exported build cache).
.env
.env.*
!.env.*.example
payload.json
test_bcrypt.js
test_login.js

# Build artefacts / VCS
node_modules
dist
.angular
.git
.github
*.log
backend/build
backend/.gradle

# The ERP has its own build contexts (projects/erp-*/Dockerfile); its node_modules,
# .next and .venv were being shipped into the storefront/admin build context (~800MB).
**/node_modules
**/.next
**/.venv
projects/erp-backend
projects/erp-frontend

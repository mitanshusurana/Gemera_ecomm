# ==========================================
# INFRASTRUCTURE SPLIT CONFIGURATION
# ==========================================
# If you are deploying on the ORIGINAL VM (Backend + DB + Admin):
# Use docker-compose.prod.backend.yml
#
# If you are deploying on the NEW VM (Frontend):
# Use docker-compose.prod.frontend.yml
# ==========================================

# ------------------------------------------
# DATABASE CONFIGURATION (Original VM Only)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_secure_password

# ------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE (Original VM Only)
# ------------------------------------------
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=jewelry-assets
R2_PUBLIC_URL=https://pub-your-account.r2.dev

# ------------------------------------------
# BACKEND CONFIGURATION (Original VM Only)
# ------------------------------------------
ADMIN_EMAIL=admin@gemara.com
ADMIN_PASSWORD=change_me_strong_password
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ------------------------------------------
# FRONTEND & ADMIN URLs
# ------------------------------------------
# IMPORTANT: Since Frontend and Admin run in the user's browser,
# these URLs must point to the PUBLIC IP or DOMAIN of the Original VM (Backend).
# Replace '<ORIGINAL_VM_PUBLIC_IP>' with the actual IP address or domain.
FRONTEND_API_URL=http://<ORIGINAL_VM_PUBLIC_IP>:8080/api/v1
ADMIN_API_URL=http://<ORIGINAL_VM_PUBLIC_IP>:8080/api/v1

# ------------------------------------------
# FRONTEND CONFIGURATION (New VM Only)
# ------------------------------------------
RAZORPAY_KEY=rzp_test_S5goGHXLEuP6hP
WHATSAPP_NUMBER=917976091951
# Include the frontend domain/IP to prevent SSR host header errors
NG_ALLOWED_HOSTS=localhost,127.0.0.1,<NEW_VM_PUBLIC_IP>

# ------------------------------------------
# CONTAINER REGISTRY (Optional - Overrides)
# ------------------------------------------
BACKEND_IMAGE=ghcr.io/mitanshusurana/gemera_ecomm-backend:latest
FRONTEND_IMAGE=ghcr.io/mitanshusurana/gemera_ecomm-frontend:latest
ADMIN_IMAGE=ghcr.io/mitanshusurana/gemera_ecomm-admin:latest

# Host names Caddy answers for. Their DNS A records must point at this VM.
# Before DNS exists, sslip.io names work: api.129-159-18-63.sslip.io resolves to 129.159.18.63.
API_HOST=api.caratloop.com
ADMIN_HOST=admin.caratloop.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=admin@caratloop.com
# Reuse the data volume of a previous deployment instead of starting empty (optional).
# POSTGRES_VOLUME=gemara-deploy_postgres_data

# Host names Caddy answers for. Their DNS A records must point at this VM.
# Before DNS exists, sslip.io names work: 68-233-96-36.sslip.io resolves to 68.233.96.36.
# Several storefront hosts are comma separated: "www.caratloop.com, caratloop.com".
STORE_HOSTS=www.caratloop.com, caratloop.com
ERP_HOST=erp.caratloop.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=admin@caratloop.com
# ERP database password, plain and URL-encoded (@ -> %40 and so on). bootstrap.sh fills these in.
ERP_POSTGRES_PASSWORD=
ERP_POSTGRES_PASSWORD_URLENC=
# Reuse an existing ERP data volume instead of starting empty (optional).
# ERP_POSTGRES_VOLUME=caratloop_erp_postgres_data
